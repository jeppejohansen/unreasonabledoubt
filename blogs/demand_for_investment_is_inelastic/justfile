# Justfile for "Demand for Investment Is Inelastic" blog post

# Solve the lifecycle model (PE sweep + GE solver + R_s sweep + savings sweep)
# Takes ~30-40 minutes.
solve:
    uv run python src/model.py

# Generate all plots (requires model results to exist)
plots:
    uv run python src/intro_plots.py
    uv run python src/supply_plots.py
    uv run python src/plots.py
    uv run python src/equilibrium_plots.py

# Compile the Typst model note to PDF (requires typst)
compile:
    typst compile --root . notes/model-framework.typ notes/model-framework.pdf

# Run everything: solve model then generate plots
all: solve plots
